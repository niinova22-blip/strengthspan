{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthspan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthspan"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthspan uses the camera only during a capacity check to count your movements on this iPhone. Images are never saved or sent anywhere."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthspan kamerayı yalnızca kapasite değerlendirmesi sırasında, hareketlerini bu iPhone'da saymak için kullanır. Görüntüler asla kaydedilmez veya gönderilmez."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthspan does not read your Apple Health data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthspan Apple Sağlık verilerini okumaz."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthspan can save your completed workouts to Apple Health."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthspan tamamladığın antrenmanları Apple Sağlık'a kaydedebilir."
          }
        }
      }
    }
  },
  "version": "1.0"
}
