            "value": "Less than halfway"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarıdan az"
          }
        }
      }
    },
    "measurement.level.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
