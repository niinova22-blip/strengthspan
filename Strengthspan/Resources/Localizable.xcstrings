    "safety.check.confirmPain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop and adjust my plan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dur ve planımı uyarla"
          }
        }
      }
    },
    "safety.check.pain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pain in part of my body"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücudumun bir yerinde ağrı"
          }
        }
      }
    },
    "safety.check.regions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where do you feel pain?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerede ağrı hissediyorsun?"
          }
        }
      }
    },
    "safety.check.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's happening?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne oluyor?"
          }
        }
      }
    },
    "safety.check.unwell": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm tired or not feeling up to it"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorgunum ya da bugün hiç havamda değilim"
          }
        }
      }
    },
    "safety.check.warningSigns": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chest pain, dizziness, feeling faint or very short of breath"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göğüs ağrısı, baş dönmesi, bayılacak gibi olma ya da ciddi nefes darlığı"
          }
        }
      }
    },
    "safety.emergency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop exercising and sit down. If symptoms are severe or don't pass within a few minutes, call your local emergency number (112 in Türkiye and Europe)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersizi bırak ve otur. Belirtiler şiddetliyse ya da birkaç dakika içinde geçmezse yerel acil numarasını ara (Türkiye'de 112)."
          }
        }
      }
    },
    "safety.painAdjusted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We've removed exercises that load this area from your plan. If the pain continues, please see a health professional."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bölgeye yük bindiren hareketleri planından çıkardık. Ağrı devam ederse lütfen bir sağlık profesyoneline görün."
          }
        }
      }
    },
    "safety.professional": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please talk to a health professional before your next session. Training is paused until you confirm you feel well."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki seanstan önce lütfen bir sağlık profesyoneliyle görüş. Kendini iyi hissettiğini onaylayana kadar antrenman duraklatıldı."
          }
        }
      }
    },
    "screening.chestPain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you feel pain, pressure or tightness in your chest during physical activity?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiziksel aktivite sırasında göğsünde ağrı, baskı ya da sıkışma hissediyor musun?"
          }
        }
      }
    },
    "screening.dizziness": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the past 12 months, have you lost your balance because of dizziness, or fainted?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 12 ayda baş dönmesi nedeniyle dengeni kaybettin mi ya da bayıldın mı?"
          }
        }
      }
    },
    "screening.jointPain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you have joint or back pain that gets worse with movement?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketle kötüleşen eklem ya da sırt ağrın var mı?"
          }
        }
      }
    },
    "screening.movementLimitation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you have any other condition that limits how you move?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketini kısıtlayan başka bir durumun var mı?"
          }
        }
      }
    },
    "screening.recentFall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you had a fall in the past 12 months?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 12 ayda düştün mü?"
          }
        }
      }
    },
    "screening.recentSurgery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you had surgery or a significant injury in the past 3 months?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 3 ay içinde ameliyat oldun mu ya da ciddi bir yaralanma geçirdin mi?"
          }
        }
      }
    },
    "screening.supervisedOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has a health professional told you to exercise only under medical supervision?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sağlık profesyoneli sana yalnızca tıbbi gözetim altında egzersiz yapmanı söyledi mi?"
          }
        }
      }
    },
    "settings.appleHealth": {
