    "settings.deleteAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all my data"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm verilerimi sil"
          }
        }
      }
    },
    "settings.deleteAll.confirm.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sil"
          }
        }
      }
    },
    "settings.deleteAll.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your profile, assessments and workouts from this iPhone. This can't be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilin, değerlendirmelerin ve antrenmanların bu iPhone'dan kalıcı olarak silinir. Bu işlem geri alınamaz."
          }
        }
      }
    },
    "settings.deleteAll.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all data?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm veriler silinsin mi?"
          }
        }
      }
    },
    "settings.deleteAll.failure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data couldn't be deleted. Please try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerin silinemedi. Lütfen tekrar dene."
          }
        }
      }
    },
    "settings.deleteAll.success": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data deleted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm veriler silindi."
          }
        }
      }
    },
    "settings.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthspan is a fitness and wellness app. It does not diagnose or treat any medical condition."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthspan bir fitness ve sağlıklı yaşam uygulamasıdır. Herhangi bir tıbbi durumu teşhis etmez veya tedavi etmez."
          }
        }
      }
    },
