    "exercise.armCircles.standing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm Circles"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kol Çevirme"
          }
        }
      }
    },
    "exercise.armCircles.standing.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with your arms out to the sides. Make small, slow circles forward, then backward. Keep your shoulders relaxed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kollarını yana aç. Önce öne, sonra geriye doğru küçük ve yavaş daireler çiz. Omuzlarını gevşek tut."
          }
        }
      }
    },
    "exercise.breathing.slow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow Breathing"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş Nefes"
          }
        }
      }
    },
    "exercise.breathing.slow.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit comfortably. Breathe in through your nose for a count of four and out slowly for a count of six. Let your shoulders relax."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahatça otur. Burnundan dört sayıda nefes al, altı sayıda yavaşça ver. Omuzlarını gevşet."
          }
        }
      }
    },
    "exercise.calfRaise.dumbbell": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dumbbell Calf Raise"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dambıllı Topuk Kaldırma"
          }
        }
      }
    },
    "exercise.calfRaise.dumbbell.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a dumbbell in one hand and a chair or counter with the other. Rise onto your toes and lower slowly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir elinde dambıl, diğer elinle sandalyeye ya da tezgâha tutun. Parmak uçlarında yüksel ve yavaşça in."
          }
        }
      }
    },
    "exercise.calfRaise.pause": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calf Raise with Pause"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekletmeli Topuk Kaldırma"
          }
        }
      }
    },
    "exercise.calfRaise.pause.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding on for support, rise onto your toes, pause for two seconds at the top and lower slowly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteğe tutunarak parmak uçlarında yüksel, yukarıda iki saniye bekle ve yavaşça in."
          }
        }
      }
    },
    "exercise.calfRaise.supported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported Calf Raise"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destekli Topuk Kaldırma"
          }
        }
      }
    },
    "exercise.calfRaise.supported.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a chair or counter. Rise slowly onto the balls of your feet, then lower your heels with control."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sandalyeye ya da tezgâha tutun. Yavaşça parmak uçlarında yüksel, sonra topuklarını kontrollü şekilde indir."
          }
        }
      }
    },
    "exercise.heelToe.counter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heel-to-Toe Walk"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topuk-Parmak Yürüyüşü"
          }
        }
      }
    },
    "exercise.heelToe.counter.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk slowly along a kitchen counter, placing each heel just in front of the toes of the other foot. Keep one hand on the counter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutfak tezgâhı boyunca yavaşça yürü; her adımda topuğunu diğer ayağının parmaklarının hemen önüne koy. Bir elin tezgâhta kalsın."
          }
        }
      }
    },
    "exercise.hinge.dumbbell": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dumbbell Hip Hinge"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dambıllı Menteşe Hareketi"
          }
        }
      }
    },
    "exercise.hinge.dumbbell.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold dumbbells in front of your thighs. Push your hips back and lower them along your legs to just below the knees with a straight back, then stand tall."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dambılları uyluklarının önünde tut. Kalçanı geriye it ve dambılları bacakların boyunca dizlerin hemen altına indir; sırtın düz olsun, sonra doğrul."
          }
        }
      }
    },
    "exercise.hinge.handsOnThighs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hip Hinge"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalçadan Menteşe Hareketi"
          }
        }
      }
    },
    "exercise.hinge.handsOnThighs.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with your hands on your thighs and knees soft. Push your hips back and let your hands slide toward your knees, keeping your back straight. Stand up by squeezing your glutes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellerin uyluklarında, dizlerin hafif bükülü dur. Kalçanı geriye it ve sırtını düz tutarak ellerini dizlerine doğru kaydır. Kalçanı sıkarak doğrul."
          }
        }
      }
    },
    "exercise.hinge.slowTempo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow Hip Hinge"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş Menteşe Hareketi"
          }
        }
      }
    },
    "exercise.hinge.slowTempo.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do the hip hinge, taking three slow seconds on the way down. Keep your back straight throughout."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menteşe hareketini inerken üç saniye sürecek şekilde yavaş yap. Sırtını baştan sona düz tut."
          }
        }
      }
    },
    "exercise.hipCircles.supported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported Hip Circles"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destekli Kalça Çevirme"
          }
        }
      }
    },
    "exercise.hipCircles.supported.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a sturdy chair. With feet hip-width apart, slowly circle your hips in one direction, then the other."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlam bir sandalyeye tutun. Ayakların kalça genişliğinde, kalçanı yavaşça bir yöne, sonra diğer yöne döndür."
          }
        }
      }
    },
    "exercise.march.inPlace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "March in Place"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerinde Yürüyüş"
          }
        }
      }
    },
    "exercise.march.inPlace.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall and lift your knees one at a time at an easy pace. Swing your arms gently. Hold a chair if you like."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dik dur ve dizlerini sırayla, rahat bir tempoda kaldır. Kollarını hafifçe salla. İstersen bir sandalyeye tutun."
          }
        }
      }
    },
    "exercise.overhead.band": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Band Overhead Press"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantla Baş Üstü İtiş"
          }
        }
      }
    },
    "exercise.overhead.band.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on the middle of the band holding an end in each hand at shoulder height. Press up overhead without arching your back, then lower slowly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandın ortasına bas, uçlarını omuz hizasında tut. Belini çukurlaştırmadan baş üstüne it, sonra yavaşça indir."
          }
        }
      }
    },
    "exercise.overhead.dumbbellSeated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated Dumbbell Press"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturarak Dambıl İtişi"
          }
        }
      }
    },
    "exercise.overhead.dumbbellSeated.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit tall in a chair with dumbbells at shoulder height. Press them up until your arms are almost straight, then lower slowly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandalyede dik otur, dambıllar omuz hizasında olsun. Kolların neredeyse düzleşene kadar yukarı it, sonra yavaşça indir."
          }
        }
      }
    },
    "exercise.overhead.wallSlide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wall Slide"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duvarda Kol Kaydırma"
          }
        }
      }
    },
    "exercise.overhead.wallSlide.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with your back to a wall, arms bent and hands at shoulder height. Slide your arms up the wall as far as is comfortable, then back down."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sırtın duvara dönük, kolların bükülü ve ellerin omuz hizasında dur. Kollarını rahat edebildiğin kadar duvar boyunca yukarı kaydır, sonra indir."
          }
        }
      }
    },
    "exercise.pushUp.counter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counter Push-Up"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tezgâhta Şınav"
          }
        }
      }
    },
    "exercise.pushUp.counter.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your hands on a sturdy kitchen counter and step your feet back. Keep your body straight as you lower your chest and push back up."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellerini sağlam bir mutfak tezgâhına koy ve ayaklarını geriye al. Göğsünü indirip geri iterken vücudunu düz tut."
          }
        }
      }
    },
    "exercise.pushUp.counterSlow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow Counter Push-Up"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş Tezgâhta Şınav"
          }
        }
      }
    },
    "exercise.pushUp.counterSlow.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do a counter push-up, but take three slow seconds to lower and pause briefly before pushing back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tezgâhta şınav gibi yap, ancak üç saniyede yavaşça in ve geri itmeden önce kısa bir an bekle."
          }
        }
      }
    },
    "exercise.pushUp.wall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wall Push-Up"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duvarda Şınav"
          }
        }
      }
    },
    "exercise.pushUp.wall.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand an arm's length from a wall with your hands on it at shoulder height. Bend your elbows to bring your chest toward the wall, then push back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duvardan bir kol boyu uzakta dur, ellerini omuz hizasında duvara koy. Dirseklerini bükerek göğsünü duvara yaklaştır, sonra geri it."
          }
        }
      }
    },
    "exercise.row.band": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Band Row"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantla Çekiş"
          }
        }
      }
    },
    "exercise.row.band.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anchor the band at chest height in a closed door or around a sturdy post. Pull the ends toward your ribs, squeezing your shoulder blades, then release slowly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandı göğüs hizasında kapalı bir kapıya ya da sağlam bir direğe sabitle. Uçları kaburgalarına doğru çek, kürek kemiklerini sık, sonra yavaşça bırak."
          }
        }
      }
    },
    "exercise.row.dumbbellSupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported Dumbbell Row"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destekli Dambıl Çekişi"
          }
        }
      }
    },
    "exercise.row.dumbbellSupported.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest one hand on a sturdy chair or table and hold a dumbbell in the other. Pull it up toward your hip, then lower slowly. Work both sides."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir elini sağlam bir sandalyeye ya da masaya daya, diğer elinde dambıl tut. Dambılı kalçana doğru çek, sonra yavaşça indir. İki tarafı da çalıştır."
          }
        }
      }
    },
    "exercise.row.shoulderSqueeze": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoulder Blade Squeeze"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürek Kemiği Sıkıştırma"
          }
        }
      }
    },
    "exercise.row.shoulderSqueeze.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit or stand tall with your elbows bent at your sides. Squeeze your shoulder blades together, hold for two seconds and relax."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirseklerin yanlarda bükülü, dik otur ya da dur. Kürek kemiklerini birbirine yaklaştır, iki saniye tut ve gevşe."
          }
        }
      }
    },
    "exercise.sideLegRaise.band": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Band Side Leg Raise"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantla Yana Bacak Kaldırma"
          }
        }
      }
    },
    "exercise.sideLegRaise.band.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop the band around your ankles and hold a chair. Lift one leg out to the side against the band, then lower slowly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandı ayak bileklerine geçir ve bir sandalyeye tutun. Bir bacağını bandın direncine karşı yana kaldır, sonra yavaşça indir."
          }
        }
      }
    },
    "exercise.sideLegRaise.supported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported Side Leg Raise"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destekli Yana Bacak Kaldırma"
          }
        }
      }
    },
    "exercise.sideLegRaise.supported.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a chair. Keeping your body upright and toes pointing forward, lift one leg out to the side and lower it slowly. Work both sides."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sandalyeye tutun. Gövden dik, ayak ucun önde olacak şekilde bir bacağını yana kaldır ve yavaşça indir. İki tarafı da çalıştır."
          }
        }
      }
    },
    "exercise.sitToStand.armsCrossed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit-to-Stand, Arms Crossed"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kollar Çapraz Oturup Kalkma"
          }
        }
      }
    },
    "exercise.sitToStand.armsCrossed.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross your arms over your chest. Lean forward and stand up without using your hands. Lower yourself back down with control."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kollarını göğsünde çaprazla. Öne eğil ve ellerini kullanmadan ayağa kalk. Kontrollü şekilde geri otur."
          }
        }
      }
    },
    "exercise.sitToStand.goblet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goblet Sit-to-Stand"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dambılla Oturup Kalkma"
          }
        }
      }
    },
    "exercise.sitToStand.goblet.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold one dumbbell close to your chest with both hands. Stand up from the chair and sit back down slowly. Choose a weight you can lift with good control."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dambılı iki elinle göğsüne yakın tut. Sandalyeden kalk ve yavaşça geri otur. Kontrollü kaldırabildiğin bir ağırlık seç."
          }
        }
      }
    },
    "exercise.sitToStand.slowLower": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow Sit-to-Stand"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş Oturup Kalkma"
          }
        }
      }
    },
    "exercise.sitToStand.slowLower.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand up as before, then take three slow seconds to sit back down. Keep your knees in line with your toes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı şekilde kalk, sonra üç saniyede yavaşça geri otur. Dizlerin ayak parmaklarınla aynı hizada kalsın."
          }
        }
      }
    },
    "exercise.sitToStand.withHands": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit-to-Stand with Hands"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elden Destekli Oturup Kalkma"
          }
        }
      }
    },
    "exercise.sitToStand.withHands.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit near the front of a sturdy chair, feet flat. Lean forward, push through your heels and use your hands on the chair or your thighs to stand. Sit back down slowly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlam bir sandalyenin önüne doğru otur, ayakların yere tam bassın. Öne eğil, topuklarından it ve ellerini sandalyeye ya da uyluklarına koyarak ayağa kalk. Yavaşça geri otur."
          }
        }
      }
    },
    "exercise.stepTap.supported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported Step Tap"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destekli Adım Dokunuşu"
          }
        }
      }
    },
    "exercise.stepTap.supported.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a chair. Tap one foot forward, to the side and back, returning to the centre each time. Switch feet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sandalyeye tutun. Bir ayağınla öne, yana ve geriye dokun, her seferinde ortaya dön. Ayak değiştir."
          }
        }
      }
    },
    "exercise.stretch.calfWall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calf Stretch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baldır Esnetme"
          }
        }
      }
    },
    "exercise.stretch.calfWall.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your hands on a wall, step one foot back and press the heel down until you feel a gentle stretch in the calf. Switch sides halfway."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellerin duvarda, bir ayağını geri al ve baldırında hafif bir gerilme hissedene kadar topuğunu yere bastır. Yarısında taraf değiştir."
          }
        }
      }
    },
    "exercise.stretch.chestOpener": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chest Opener"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göğüs Açma"
          }
        }
      }
    },
    "exercise.stretch.chestOpener.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clasp your hands behind your back or rest them on your lower back. Gently draw your shoulders back and breathe slowly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellerini arkanda birleştir ya da belinin üstüne koy. Omuzlarını nazikçe geriye al ve yavaş nefes al."
          }
        }
      }
    },
    "exercise.stretch.hamstringSeated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated Hamstring Stretch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturarak Arka Bacak Esnetme"
          }
        }
      }
    },
    "exercise.stretch.hamstringSeated.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit near the edge of a chair with one leg straight and the heel on the floor. Sit tall and lean forward slightly until you feel a gentle stretch. Switch sides halfway."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandalyenin ucuna otur, bir bacağın düz ve topuğun yerde olsun. Dik otur ve hafif bir gerilme hissedene kadar biraz öne eğil. Yarısında taraf değiştir."
          }
        }
      }
    },
    "exercise.tandem.full": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandem Stand"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandem Duruş"
          }
        }
      }
    },
    "exercise.tandem.full.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding a counter, place one foot directly in front of the other, heel touching toe. Stand steady, then switch feet. Keep a hand on the counter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tezgâha tutunarak bir ayağını diğerinin tam önüne koy, topuk parmak ucuna değsin. Dengede dur, sonra ayak değiştir. Bir elin tezgâhta kalsın."
          }
        }
      }
    },
    "exercise.tandem.semi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Semi-Tandem Stand"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarı Tandem Duruş"
          }
        }
      }
    },
    "exercise.tandem.semi.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding a counter, place one foot half a step ahead so its heel is beside the big toe of the other foot. Stand steady and hold on whenever you need to."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tezgâha tutunarak bir ayağını yarım adım öne al; topuğu diğer ayağının başparmağının yanında olsun. Dengede dur, gerektiğinde tutun."
          }
        }
      }
    },
    "exercise.weightShift.supported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported Weight Shift"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destekli Ağırlık Aktarma"
          }
        }
      }
    },
    "exercise.weightShift.supported.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a counter with your feet hip-width apart. Slowly shift your weight to one foot, then the other, without lifting your feet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayakların kalça genişliğinde, bir tezgâha tutun. Ayaklarını kaldırmadan ağırlığını yavaşça bir ayağına, sonra diğerine aktar."
          }
        }
      }
    },
