{
  "sourceLanguage": "en",
  "strings": {
    "assessment.calfRaise30s": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30-Second Calf Raise"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 Saniye Topuk Kaldırma"
          }
        }
      }
    },
    "assessment.calfRaise30s.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand facing a counter and hold it lightly. When the timer starts, rise onto the balls of both feet and lower again, as many times as you can in 30 seconds. Tap once for each rise."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tezgâha dönük dur ve hafifçe tutun. Süre başlayınca 30 saniye içinde olabildiğince çok kez iki ayağının parmak uçlarında yüksel ve in. Her yükselişte bir kez dokun."
          }
        }
      }
    },
    "assessment.calfRaise30s.setup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This test is counted by hand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu test elle sayılır."
          }
        }
      }
    },
    "assessment.camera.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off. You can allow it in iOS Settings, or measure this test by hand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera erişimi kapalı. iOS Ayarlar'dan izin verebilir ya da bu testi elle ölçebilirsin."
          }
        }
      }
    },
    "assessment.camera.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti."
          }
        }
      }
    },
    "assessment.camera.go": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başla!"
          }
        }
      }
    },
    "assessment.camera.jointsNotVisible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn sideways and step back until your hips, knees and feet are visible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yan dön ve kalçan, dizlerin ve ayakların görünene kadar geri çekil."
          }
        }
      }
    },
    "assessment.camera.measuring": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep going at a safe pace."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli bir tempoda devam et."
          }
        }
      }
    },
    "assessment.camera.multiplePeople": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure only you are in view."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadrajda yalnızca senin olduğundan emin ol."
          }
        }
      }
    },
    "assessment.camera.noPerson": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step into view so your whole body is visible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm vücudun görünecek şekilde kadraja gir."
          }
        }
      }
    },
    "assessment.camera.outOfFrame": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step back a little — part of your body is out of the picture."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz geri çekil — vücudunun bir kısmı kadrajın dışında."
          }
        }
      }
    },
    "assessment.camera.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold still — starting shortly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıpırdama — birazdan başlıyoruz."
          }
        }
      }
    },
    "assessment.camera.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera isn't available on this device. You can measure this test by hand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda kamera kullanılamıyor. Bu testi elle ölçebilirsin."
          }
        }
      }
    },
    "assessment.chairStand30s": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30-Second Chair Stand"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 Saniye Sandalyeden Kalkma"
          }
        }
      }
    },
    "assessment.chairStand30s.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit in the middle of a sturdy chair without wheels, placed against a wall, with your arms crossed over your chest. When the timer starts, stand up fully and sit back down as many times as you can in 30 seconds. Go at a pace that feels safe and stop if you feel unwell."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duvara dayalı, tekerleksiz sağlam bir sandalyenin ortasına otur, kollarını göğsünde çaprazla. Süre başlayınca 30 saniye içinde olabildiğince çok kez tamamen ayağa kalk ve geri otur. Güvenli hissettiğin bir tempoda yap, kendini iyi hissetmezsen dur."
          }
        }
      }
    },
    "assessment.chairStand30s.setup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean your iPhone against something stable 2–3 metres away at hip height, so it sees you from the side. Your hips, knees and ankles must stay visible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'unu 2–3 metre uzakta, kalça hizasında sabit bir yere yasla; seni yandan görsün. Kalçan, dizlerin ve ayak bileklerin görünür kalmalı."
          }
        }
      }
    },
    "assessment.fiveTimesSitToStand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five Times Sit-to-Stand"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 Kez Oturup Kalkma"
          }
        }
      }
    },
    "assessment.fiveTimesSitToStand.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit in the chair with your arms crossed. When the timer starts, stand up fully and sit down five times as quickly as you safely can. Stop the timer after the fifth stand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kollarını çaprazlayarak sandalyeye otur. Süre başlayınca güvenli şekilde yapabildiğin en hızlı tempoyla beş kez tamamen kalk ve otur. Beşinci kalkıştan sonra süre durur."
          }
        }
      }
    },
    "assessment.fiveTimesSitToStand.setup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean your iPhone against something stable 2–3 metres away at hip height, so it sees you from the side. Your hips, knees and ankles must stay visible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'unu 2–3 metre uzakta, kalça hizasında sabit bir yere yasla; seni yandan görsün. Kalçan, dizlerin ve ayak bileklerin görünür kalmalı."
          }
        }
      }
    },
    "assessment.intro.beta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta: camera measurement for this test is still being validated. Treat the value as an estimate."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta: bu test için kamera ölçümü henüz doğrulanıyor. Değeri bir tahmin olarak düşün."
          }
        }
      }
    },
    "assessment.intro.cameraSetup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the camera"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayla ölçüm"
          }
        }
      }
    },
    "assessment.intro.skip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip this test"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu testi atla"
          }
        }
      }
    },
    "assessment.intro.useCamera": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure with the camera"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayla ölç"
          }
        }
      }
    },
    "assessment.manual.confirmCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the count and correct it if needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayıyı kontrol et, gerekirse düzelt."
          }
        }
      }
    },
    "assessment.manual.couldNotFinish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't finish"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlayamadım"
          }
        }
      }
    },
    "assessment.manual.fiveDone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop — five stands done"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdur — beş kalkış tamam"
          }
        }
      }
    },
    "assessment.manual.holdStop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop timer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreyi durdur"
          }
        }
      }
    },
    "assessment.manual.reachQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far could you comfortably raise your arm?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolunu rahatça ne kadar kaldırabildin?"
          }
        }
      }
    },
    "assessment.manual.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start timer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreyi başlat"
          }
        }
      }
    },
    "assessment.manual.tapEach": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap once for every repetition"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her tekrarda bir kez dokun"
          }
        }
      }
    },
    "assessment.manual.undo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo last tap"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son dokunuşu geri al"
          }
        }
      }
    },
    "assessment.overheadReach": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overhead Reach"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baş Üstüne Uzanma"
          }
        }
      }
    },
    "assessment.overheadReach.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall with your arms by your sides. Slowly raise one arm forward and up as high as is comfortable, then lower it. Don't force the movement."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolların yanlarda, dik dur. Bir kolunu yavaşça önden yukarı, rahat edebildiğin kadar kaldır, sonra indir. Hareketi zorlama."
          }
        }
      }
    },
    "assessment.overheadReach.setup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your iPhone 2 metres away at chest height so it sees you from the side. Your hip, shoulder, elbow and wrist must be visible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'unu 2 metre uzakta, göğüs hizasında yerleştir; seni yandan görsün. Kalçan, omzun, dirseğin ve bileğin görünür olmalı."
          }
        }
      }
    },
    "assessment.overview.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five short tests of strength, balance, mobility and movement control. It takes about 10 minutes. You can skip any test, and you can stop at any time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvvet, denge, mobilite ve hareket kontrolü için beş kısa test. Yaklaşık 10 dakika sürer. İstediğin testi atlayabilir, istediğin an durabilirsin."
          }
        }
      }
    },
    "assessment.overview.prepare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you start"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamadan önce"
          }
        }
      }
    },
    "assessment.overview.prepareList": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• A sturdy chair without wheels, placed against a wall\n• A kitchen counter or table to hold\n• Comfortable shoes and some clear space"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Duvara dayalı, tekerleksiz sağlam bir sandalye\n• Tutunmak için bir mutfak tezgâhı ya da masa\n• Rahat ayakkabılar ve biraz boş alan"
          }
        }
      }
    },
    "assessment.overview.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başla"
          }
        }
      }
    },
    "assessment.overview.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacity check"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapasite değerlendirmesi"
          }
        }
      }
    },
    "assessment.progress %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test %1$lld of %2$lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test %1$lld / %2$lld"
          }
        }
      }
    },
    "assessment.result.cameraEstimate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera estimate. You can measure by hand instead if it looks wrong."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tahmini. Yanlış görünüyorsa elle de ölçebilirsin."
          }
        }
      }
    },
    "assessment.result.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam"
          }
        }
      }
    },
    "assessment.result.lowQuality": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't measure this reliably, so no result was saved. Try again with better lighting and your whole body in view, or measure by hand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu güvenilir şekilde ölçemedik, bu yüzden sonuç kaydedilmedi. Daha iyi ışıkta ve tüm vücudun görünürken tekrar dene ya da elle ölç."
          }
        }
      }
    },
    "assessment.result.manualNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured by you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senin ölçümün."
          }
        }
      }
    },
    "assessment.result.notCompleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not completed — that's completely fine. We'll note it and build from where you are."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanmadı — bu tamamen normal. Bunu not edip bulunduğun yerden ilerleyeceğiz."
          }
        }
      }
    },
    "assessment.result.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar dene"
          }
        }
      }
    },
    "assessment.result.save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save result"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonucu kaydet"
          }
        }
      }
    },
    "assessment.saved.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your capacity map is updated. We'll suggest the next check in four weeks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapasite haritan güncellendi. Bir sonraki değerlendirmeyi dört hafta sonra önereceğiz."
          }
        }
      }
    },
    "assessment.saved.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacity check saved"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değerlendirme kaydedildi"
          }
        }
      }
    },
    "assessment.summary.noResult": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No result"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç yok"
          }
        }
      }
    },
    "assessment.summary.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results are compared only with your own future checks done the same way."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuçlar yalnızca aynı şekilde yapılan kendi sonraki ölçümlerinle karşılaştırılır."
          }
        }
      }
    },
    "assessment.summary.save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save capacity check"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değerlendirmeyi kaydet"
          }
        }
      }
    },
    "assessment.summary.skipped": {
