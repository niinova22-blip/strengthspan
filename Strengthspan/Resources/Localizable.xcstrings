    "progress.capacityMap.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores only compare you with your own earlier measurements. They are not a medical assessment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puanlar seni yalnızca kendi önceki ölçümlerinle karşılaştırır. Tıbbi bir değerlendirme değildir."
          }
        }
      }
    },
