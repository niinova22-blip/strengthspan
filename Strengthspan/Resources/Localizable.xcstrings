    "assessment.supportedSemiTandem": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported Balance Stand"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destekli Denge Duruşu"
          }
        }
      }
    },
    "assessment.supportedSemiTandem.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand next to a counter with one hand resting on it. Place one foot half a step ahead so its heel is beside the big toe of the other foot. Start the timer and hold the position for up to 30 seconds. Keep your hand on the counter, and stop the timer if you need to step out."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir elin tezgâhın üzerinde, tezgâhın yanında dur. Bir ayağını yarım adım öne al; topuğu diğer ayağının başparmağının yanında olsun. Süreyi başlat ve bu duruşu en fazla 30 saniye koru. Elin tezgâhta kalsın; adım atman gerekirse süreyi durdur."
          }
        }
      }
    },
    "assessment.supportedSemiTandem.setup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This test is measured by hand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu test elle ölçülür."
          }
        }
      }
    },
